{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./public/build",
    "paths": {
      "@scripts/*": ["./resources/js/*"],
      "@styles/*": ["./resources/css/*"],
      "@fonts/*": ["./resources/fonts/*"],
      "@images/*": ["./resources/images/*"]
    },
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["types/octa.d.ts", "vite.config.ts"],
  "include": ["resources"]
}
